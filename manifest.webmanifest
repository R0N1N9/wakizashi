{
  "name": "Wakizashi 脇差 — security toolkit",
  "short_name": "Wakizashi",
  "description": "The web edition of the Katana security suite: threat intel, detection, red-team planning and OPSEC — all on-device.",
  "id": "./",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#060a0f",
  "theme_color": "#0a0f16",
  "categories": ["security", "utilities", "productivity"],
  "icons": [
    { "src": "assets/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Extract IOCs", "url": "./#/yumi/extract", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Enrichment workbench", "url": "./#/yumi/workbench", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Hunt logs", "url": "./#/yoroi/hunt", "icons": [{ "src": "assets/icon-192.png", "sizes": "192x192" }] }
  ]
}
